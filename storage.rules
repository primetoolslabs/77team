rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){ return request.auth != null; }
    function profileExists(){ return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)); }
    function profile(){ return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function isDevRole(role){ return role in ['dev','owner','DEV','Owner','developer']; }
    function isLeadershipRole(role){ return role in ['leadership','lideranca','Liderança','Lideranca','lider','leader','administrador','admin']; }
    function isStaffRole(role){ return role in ['staff','Staff','moderador','moderator']; }
    function accessRole(){
      let data = profile();
      let access = data.get('accessRole','');
      let system = data.get('systemRole','');
      let permissionRole = data.get('permissionRole','');
      let userRole = data.get('userRole','');
      let cargo = data.get('cargo','');
      let role = data.get('role','');
      let memberRole = data.get('memberRole','');
      return isDevRole(access) || isLeadershipRole(access) || isStaffRole(access) ? access
        : isDevRole(system) || isLeadershipRole(system) || isStaffRole(system) ? system
        : isDevRole(permissionRole) || isLeadershipRole(permissionRole) || isStaffRole(permissionRole) ? permissionRole
        : isDevRole(userRole) || isLeadershipRole(userRole) || isStaffRole(userRole) ? userRole
        : isDevRole(cargo) || isLeadershipRole(cargo) || isStaffRole(cargo) ? cargo
        : isDevRole(role) || isLeadershipRole(role) || isStaffRole(role) ? role
        : isDevRole(memberRole) || isLeadershipRole(memberRole) || isStaffRole(memberRole) ? memberRole
        : access != '' ? access : role != '' ? role : memberRole != '' ? memberRole : 'member';
    }
    function active(){ return profileExists() && profile().get('active',false) == true && profile().get('status','approved') == 'approved'; }
    function dev(){ return active() && isDevRole(accessRole()); }
    function leadership(){ return active() && isLeadershipRole(accessRole()); }
    function staff(){ return active() && isStaffRole(accessRole()); }
    function roleKey(){ return dev() ? 'dev' : leadership() ? 'leadership' : staff() ? 'staff' : active() ? 'member' : 'guest'; }
    function defaultPermission(key){
      let role = roleKey();
      return role == 'dev'
        || (role == 'leadership' && key in ['access_staff','support_manage','page_atendimento','page_chat'])
        || (role == 'staff' && key in ['access_staff','support_manage','page_atendimento','page_chat']);
    }
    function permission(key){
      let cfg = firestore.exists(/databases/(default)/documents/settings/app)
        ? firestore.get(/databases/(default)/documents/settings/app).data.get('rolePermissions', {})
        : {};
      return dev() || cfg.get(key, {}).get(roleKey(), defaultPermission(key));
    }
    function supportManager(){ return active() && permission('access_staff') && permission('support_manage'); }
    function loginCustomizer(){ return active() && permission('login_customize'); }
    function validImage(){ return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)'); }

    match /login-customization/{fileName} {
      allow read: if true;
      allow create, update: if loginCustomizer() && validImage();
      allow delete: if loginCustomizer();
    }
    match /support/{ownerUid}/{ticketId}/{fileName} {
      allow read: if active() && (request.auth.uid == ownerUid || supportManager());
      allow create, update: if active() && (request.auth.uid == ownerUid || supportManager()) && validImage();
      allow delete: if supportManager();
    }
    match /chat/{ownerUid}/{fileName} {
      allow read: if active() && (request.auth.uid == ownerUid || supportManager());
      allow create, update: if active() && (request.auth.uid == ownerUid || supportManager()) && validImage();
      allow delete: if supportManager();
    }
    match /chat/{ownerUid}/{chatId}/{fileName} {
      allow read: if active() && (request.auth.uid == ownerUid || supportManager());
      allow create, update: if active() && (request.auth.uid == ownerUid || supportManager()) && validImage();
      allow delete: if supportManager();
    }
  }
}
