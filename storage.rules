rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){ return request.auth != null; }
    function profile(){ return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function active(){ return signedIn() && profile().get('active',false) == true && profile().get('status','') == 'approved'; }
    function role(){ return active() ? profile().get('accessRole', profile().get('role','member')) : 'guest'; }
    function editor(){ return active() && role() in ['dev','owner','leadership','lideranca','staff','Staff']; }
    function dev(){ return active() && role() in ['dev','owner']; }
    function validImage(){ return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)'); }
    match /login-customization/{fileName} { allow read: if true; allow write: if dev() && validImage(); }
    match /support/{ownerUid}/{ticketId}/{fileName} {
      allow read: if active() && (request.auth.uid == ownerUid || editor());
      allow create, update: if active() && (request.auth.uid == ownerUid || editor()) && validImage();
      allow delete: if editor();
    }
    match /chat/{ownerUid}/{allPaths=**} {
      allow read: if active() && (request.auth.uid == ownerUid || editor());
      allow create, update: if active() && (request.auth.uid == ownerUid || editor()) && validImage();
      allow delete: if editor();
    }
  }
}
