rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth != null;}
    function profileExists(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));}
    function profile(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
    // Compatibilidade com contas novas e perfis legados. accessRole é a
    // fonte preferencial; os demais campos só são usados como fallback.
    function accessRoleOf(data){
      return data.get('accessRole',
        data.get('systemRole',
          data.get('permissionRole',
            data.get('userRole',
              data.get('cargo', data.get('role','member'))))));
    }
    function isDevRole(role){return role in ['dev','owner','DEV','Owner','developer'];}
    function isLeadershipRole(role){return role in ['leadership','lideranca','Liderança','Lideranca','lider','leader','administrador','admin'];}
    function isStaffRole(role){return role in ['staff','Staff','moderador','moderator'];}
    function isMemberRole(role){return role in ['member','membro','membros','Membro','Membros','PT TIME','PT BOOST','PT CORE'];}
    function currentAccessRole(){return profileExists() ? accessRoleOf(profile()) : 'guest';}
    function active(){return profileExists() && profile().get('active',false) == true && profile().get('status','approved') == 'approved';}
    function dev(){return active() && isDevRole(currentAccessRole());}
    function leadership(){return active() && isLeadershipRole(currentAccessRole());}
    function staff(){return active() && isStaffRole(currentAccessRole());}
    function editor(){return dev() || leadership() || staff();}
    function roleKey(){ return dev() ? 'dev' : leadership() ? 'leadership' : staff() ? 'staff' : active() ? 'member' : 'guest'; }
    function permission(key, fallback){
      let cfg = get(/databases/$(database)/documents/settings/app).data.get('rolePermissions', {});
      return dev() || cfg.get(key, {}).get(roleKey(), fallback);
    }
    function ownerExists(){return exists(/databases/$(database)/documents/system/owner);}
    function bootstrapAuthorized(){
      return signedIn()
        && exists(/databases/$(database)/documents/system/bootstrap)
        && get(/databases/$(database)/documents/system/bootstrap).data.allowedEmail == request.auth.token.email;
    }
    function pendingMember(){return isMemberRole(accessRoleOf(resource.data)) && resource.data.get('status','pending') == 'pending' && resource.data.get('active',false) == false;}
    function approvalFields(){return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','accessRole','active','status','clan','memberRole','approvedAt','roleUpdatedAt','roleUpdatedBy','updatedAt']);}
    function rejectionFields(){return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','status','rejectedAt','rejectedBy','updatedAt']);}

    match /system/owner {
      allow get: if true;
      allow create: if bootstrapAuthorized() && !ownerExists() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isDevRole(accessRoleOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
      allow update, delete: if dev();
    }
    match /system/bootstrap {
      allow read: if false;
      allow create, update, delete: if dev();
    }

    match /users/{uid} {
      // A leitura do próprio perfil não depende da avaliação de cargo.
      // Isso evita bloquear o login enquanto o sistema ainda está carregando o perfil.
      allow get: if signedIn() && request.auth.uid == uid;
      allow get, list: if editor();
      allow create: if signedIn() && (
        (request.auth.uid == uid && !ownerExists() && bootstrapAuthorized()
          && request.resource.data.email == request.auth.token.email
          && isDevRole(accessRoleOf(request.resource.data)) && request.resource.data.active == true && request.resource.data.status == 'approved')
        ||
        // Recuperação segura do perfil do DEV quando system/owner aponta para o usuário autenticado.
        (request.auth.uid == uid && ownerExists()
          && get(/databases/$(database)/documents/system/owner).data.uid == request.auth.uid
          && isDevRole(accessRoleOf(request.resource.data))
          && request.resource.data.active == true && request.resource.data.status == 'approved')
        ||
        (request.auth.uid == uid && isMemberRole(accessRoleOf(request.resource.data)) && request.resource.data.active == false && request.resource.data.status == 'pending')
        ||
        (dev() && (isDevRole(accessRoleOf(request.resource.data)) || isLeadershipRole(accessRoleOf(request.resource.data)) || isStaffRole(accessRoleOf(request.resource.data))) && request.resource.data.active == true && request.resource.data.status == 'approved')
        ||
        (dev() && request.resource.data.restoredBy == request.auth.uid)
      );

      // V22.7.0 — autoedição segura e direta do próprio perfil/personagem.
      // Esta condição é avaliada antes das regras administrativas e permite ao
      // usuário alterar somente os campos pessoais listados abaixo. Campos de
      // cargo, status, ativação, UID e permissões não entram na lista e, por
      // isso, permanecem protegidos automaticamente.
      allow update: if (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','displayName','nickname','discord','whatsapp','birthDate','bio',
            'email','avatarDataUrl','updatedAt',
            'character','characterUpdatedAt','characterUpdatedBy',
            'characterDeletedAt','characterDeletedBy',
            'firstLogin','profileCompleted','profileCompletedAt'
          ])
        )
        || dev()
        || (
          leadership() && pendingMember() && approvalFields()
          && (isMemberRole(accessRoleOf(request.resource.data)) || isStaffRole(accessRoleOf(request.resource.data)))
          && request.resource.data.active == true && request.resource.data.status == 'approved'
          && request.resource.data.roleUpdatedBy == request.auth.uid
        )
        || (
          staff() && permission('requests_approve', true) && pendingMember() && approvalFields()
          && isMemberRole(accessRoleOf(request.resource.data))
          && request.resource.data.active == true && request.resource.data.status == 'approved'
          && request.resource.data.roleUpdatedBy == request.auth.uid
        )
        || (
          editor() && permission('requests_reject', true) && pendingMember() && rejectionFields()
          && isMemberRole(accessRoleOf(request.resource.data))
          && request.resource.data.active == false && request.resource.data.status == 'rejected'
          && request.resource.data.rejectedBy == request.auth.uid
        )
        || (
          leadership() && permission('roles_change', true)
          && resource.data.get('status','approved') == 'approved' && resource.data.get('active',true) == true
          && (isMemberRole(accessRoleOf(resource.data)) || isStaffRole(accessRoleOf(resource.data)))
          && (isMemberRole(accessRoleOf(request.resource.data)) || isStaffRole(accessRoleOf(request.resource.data)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','accessRole','memberRole','roleUpdatedAt','roleUpdatedBy','updatedAt'])
          && request.resource.data.roleUpdatedBy == request.auth.uid
        )
        || (
          editor() && permission('character_edit', true)
          && resource.data.get('status','approved') == 'approved' && resource.data.get('active',true) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['character','characterUpdatedAt','characterUpdatedBy','updatedAt'])
          && request.resource.data.characterUpdatedBy == request.auth.uid
        )
        || (
          editor() && permission('members_edit', true)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clan','clanUpdatedAt','clanUpdatedBy','updatedAt'])
          && request.resource.data.clanUpdatedBy == request.auth.uid
        )
        || (
          editor() && permission('character_delete', true)
          && resource.data.keys().hasAny(['character'])
          && !request.resource.data.keys().hasAny(['character'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['character','characterUpdatedAt','characterUpdatedBy','characterDeletedAt','characterDeletedBy','updatedAt'])
          && request.resource.data.characterDeletedBy == request.auth.uid
          && (
            dev()
            || (leadership() && (isMemberRole(accessRoleOf(resource.data)) || isStaffRole(accessRoleOf(resource.data))))
            || (staff() && isMemberRole(accessRoleOf(resource.data)))
          )
        );
      allow delete: if dev() && uid != request.auth.uid;
    }

    match /members/{id} {
      allow read: if active();
      allow create: if editor() && permission('members_edit', true);
      allow update: if editor() && permission('members_edit', true) && (permission('roles_change', false) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','accessRole','memberRole']));
      allow delete: if permission('members_delete', false);
    }
    match /attendance/{id} {
      allow read: if editor() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if permission('presence_register', false);
      allow update: if permission('presence_edit', false);
      allow delete: if permission('presence_delete', false) || permission('presence_reset', false);
    }
    match /events/{id} { allow read: if active(); allow write: if editor(); }
    match /rtPresence/{id} {
      allow read: if editor();
      allow create: if permission('presence_finalize', false);
      allow update: if permission('presence_finalize', false);
      allow delete: if permission('presence_reset', false) || dev();
    }
    match /presenceBackups/{id} {
      allow read: if editor();
      allow create: if editor() && permission('presence_register', true);
      allow update: if dev() && request.resource.data.restoredBy == request.auth.uid;
      allow delete: if dev();
      match /attendance/{recordId} { allow read: if editor(); allow create: if editor() && permission('presence_register', true); allow update: if dev() && request.resource.data.restoredBy == request.auth.uid; allow delete: if dev(); }
      match /rt/{recordId} { allow read: if editor(); allow create: if editor() && permission('presence_register', true); allow update: if dev() && request.resource.data.restoredBy == request.auth.uid; allow delete: if dev(); }
    }
    match /resetJobs/{id} {
      allow read, create, update: if permission('presence_reset', false);
      allow delete: if dev();
    }
    match /restoreJobs/{id} {
      allow read, create, update, delete: if dev();
    }
    match /notifications/{id} {
      allow read: if editor() || (active() && (
        resource.data.get('targetType','all') == 'all'
        || resource.data.get('targetUserId','') == request.auth.uid
        || (resource.data.get('targetType','') == 'member' && isMemberRole(currentAccessRole()))
        || (resource.data.get('targetType','') == 'staff' && (isStaffRole(currentAccessRole()) || isLeadershipRole(currentAccessRole()) || isDevRole(currentAccessRole())))
      ));
      allow create: if (editor() && permission('notifications_send', true) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('targetType','all') in ['all','user','member','staff']
        && request.resource.data.get('title','') is string && request.resource.data.get('message','') is string)
        || (dev() && request.resource.data.restoredBy == request.auth.uid);
      allow update: if dev() && request.resource.data.restoredBy == request.auth.uid;
      allow delete: if dev();
    }
    match /notificationReads/{id} {
      allow read: if dev() || (active() && resource.data.userId == request.auth.uid);
      allow create, update: if (active() && request.resource.data.userId == request.auth.uid && request.resource.data.notificationId is string)
        || (dev() && request.resource.data.restoredBy == request.auth.uid);
      allow delete: if dev() || (active() && resource.data.userId == request.auth.uid);
    }

    match /supportMessages/{id} {
      allow read: if (editor() && permission('support_manage', true)) || (active() && resource.data.ownerUid == request.auth.uid && resource.data.status != 'resolved');
      allow create: if (active()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.ownerUid is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && (request.resource.data.text.size() > 0 || request.resource.data.get('imageUrl','') != '')
        && ((editor() && permission('support_manage', true)) || request.resource.data.ownerUid == request.auth.uid))
        || (dev() && request.resource.data.restoredBy == request.auth.uid);
      allow update: if (editor() && permission('support_manage', true)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','statusUpdatedAt','statusUpdatedBy'])
        && request.resource.data.status in ['open','in_progress','waiting_user','resolved'])
        || (dev() && request.resource.data.restoredBy == request.auth.uid);
      allow delete: if dev();
    }

    match /chatMessages/{id} {
      allow read: if (editor() && permission('support_manage', true)) || (active() && resource.data.ownerUid == request.auth.uid);
      allow create: if (active()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.ownerUid is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.get('chatStatus','active') == 'active'
        && (request.resource.data.text.size() > 0 || request.resource.data.get('imageUrl','') != '')
        && ((editor() && permission('support_manage', true)) || request.resource.data.ownerUid == request.auth.uid))
        || (dev() && request.resource.data.restoredBy == request.auth.uid);
      allow update: if (editor() && permission('support_manage', true)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatStatus','finalizedAt','finalizedBy'])
        && request.resource.data.chatStatus == 'finalized')
        || (dev() && request.resource.data.restoredBy == request.auth.uid);
      allow delete: if dev();
    }
    match /settings/{id} {
      allow read: if id == 'app' || (id == 'private' && dev());
      allow write: if (id == 'app' && permission('settings_edit', false)) || (id == 'private' && dev());
    }
    match /xpLogs/{id} { allow read, create: if editor(); allow update: if dev() && request.resource.data.restoredBy == request.auth.uid; allow delete: if dev(); }
    match /audit/{id} {
      allow read: if dev() || (leadership() && permission('audit_view', true));
      allow create: if (editor() && request.resource.data.userId == request.auth.uid)
        || (active() && request.resource.data.userId == request.auth.uid && request.resource.data.action == 'Primeiro acesso concluído')
        || (dev() && request.resource.data.restoredBy == request.auth.uid);
      allow update: if dev() && request.resource.data.restoredBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
