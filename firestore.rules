rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function me(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myData(){ return me().data; }
    function approved(){ return signedIn() && myData().status == 'approved' && myData().active == true; }
    function role(){ return approved() ? myData().accessRole : 'member'; }
    function isDev(){ return role() == 'dev'; }
    function isLeadership(){ return role() == 'leadership'; }
    function isStaff(){ return role() == 'staff'; }
    function approver(){ return isDev() || isLeadership() || isStaff(); }
    function validSelfRegistration(){
      return request.resource.data.accessRole == 'member'
        && request.resource.data.memberRole == 'Membros'
        && request.resource.data.status == 'pending'
        && request.resource.data.active == false
        && request.resource.data.email == request.auth.token.email;
    }
    function staffCanApproveTarget(){
      return isStaff() && resource.data.status == 'pending' && resource.data.requestedAccessRole == 'member';
    }
    function leadershipCanApproveTarget(){
      return isLeadership() && resource.data.status == 'pending' && resource.data.requestedAccessRole in ['member','staff'];
    }
    function devCanApproveTarget(){ return isDev() && resource.data.status == 'pending'; }
    function approvalUpdate(){
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status','active','accessRole','memberRole','approvedAt','approvedBy','updatedAt',
        'rejectedAt','rejectedBy'
      ]);
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && validSelfRegistration();
      allow read: if signedIn() && (request.auth.uid == uid || approver());
      allow update: if signedIn() && approver() && approvalUpdate()
        && (devCanApproveTarget() || leadershipCanApproveTarget() || staffCanApproveTarget());
      allow delete: if isDev();
    }

    match /members/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && approver()
        && request.resource.data.userId == uid
        && (
          isDev() ||
          (isLeadership() && request.resource.data.accessRole in ['member','staff']) ||
          (isStaff() && request.resource.data.accessRole == 'member')
        );
      allow delete: if isDev() || isLeadership();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
